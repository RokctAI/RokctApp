{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "manager",
  "description": "Configuration list of active SDKs for paas_manager",
  "sdks": [
    {
      "name": "core_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/core_sdk"
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/auth/dart",
      "git": "https://github.com/RokctAI/Users",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/users/dart",
      "git": "https://github.com/RokctAI/Users",
      "ref": "main"
    },
    {
      "name": "merchants_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/merchants/dart",
      "home_sdk": true,
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "products_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/products/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "orders_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/orders/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "kitchen_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/commerce",
      "path": "../commerce/kitchen/dart",
      "ref": "main"
    },
    {
      "name": "hardware_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/hardware",
      "path": "../hardware/hardware/dart",
      "ref": "main"
    },
    {
      "name": "payments_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/payments_sdk"
    },
    {
      "name": "subscriptions_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/subscriptions_sdk"
    },
    {
      "name": "comms_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/comms_sdk"
    },
    {
      "name": "processing_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/processing_sdk"
    },
    {
      "name": "productivity_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/productivity_sdk",
      "_comment": "Included but not present in original apps"
    },
    {
      "name": "corporate_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/corporate_sdk"
    },
    {
      "name": "promotions_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/promotions/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "map_sdk",
      "enabled": true,
      "source": "git",
      "path": "../zones/map/dart",
      "git": "https://github.com/RokctAI/zones",
      "ref": "main"
    },
    {
      "name": "agent_sdk",
      "enabled": false,
      "source": "local",
      "path": "sdk/agent_sdk",
      "_comment": "Disabled as per requirements"
    }
  ]
}