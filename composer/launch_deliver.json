{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "launch_deliver",
  "description": "Configuration list of active SDKs for launch_deliver",
  "sdks": [
    {
      "name": "core_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/core_sdk"
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/auth/dart",
      "git": "https://github.com/RokctAI/Users",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/users/dart",
      "git": "https://github.com/RokctAI/Users",
      "ref": "main"
    },
    {
      "name": "orders_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/orders/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "delivery_sdk",
      "enabled": true,
      "source": "git",
      "path": "../zones/delivery/dart",
      "git": "https://github.com/RokctAI/zones",
      "ref": "main"
    },
    {
      "name": "comms_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/comms_sdk"
    },
    {
      "name": "processing_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/processing_sdk"
    },
    {
      "name": "launch_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/launch_sdk",
      "home_sdk": true
    },
    {
      "name": "corporate_sdk",
      "enabled": true,
      "source": "local",
      "path": "sdk/corporate_sdk"
    },
    {
      "name": "map_sdk",
      "enabled": true,
      "source": "git",
      "path": "../zones/map/dart",
      "git": "https://github.com/RokctAI/zones",
      "ref": "main"
    },
    {
      "name": "agent_sdk",
      "enabled": false,
      "source": "local",
      "path": "sdk/agent_sdk",
      "_comment": "Disabled as per requirements"
    }
  ]
}