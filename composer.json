{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "manager",
  "description": "Configuration list of active SDKs for paas_manager",
  "sdks": [
    {
      "name": "core_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/core/dart"
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/dart",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/dart",
      "ref": "main"
    },
    {
      "name": "merchants_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/merchants/dart",
      "home_sdk": true,
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "products_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/products/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "orders_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/orders/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "payments_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/payments/dart"
    },
    {
      "name": "subscriptions_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/subscriptions/dart"
    },
    {
      "name": "comms_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/comms/dart"
    },
    {
      "name": "processing_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/processing/dart"
    },
    {
      "name": "productivity_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/productivity/dart",
      "_comment": "Included but not present in original apps"
    },
    {
      "name": "corporate_sdk",
      "enabled": true,
      "source": "local",
      "path": "../SDKs/corporate/dart"
    },
    {
      "name": "promotions_sdk",
      "enabled": true,
      "source": "git",
      "path": "../commerce/promotions/dart",
      "git": "https://github.com/RokctAI/commerce",
      "ref": "main"
    },
    {
      "name": "map_sdk",
      "enabled": true,
      "source": "git",
      "path": "../zones/map/dart",
      "git": "https://github.com/RokctAI/zones",
      "ref": "main"
    },
    {
      "name": "agent_sdk",
      "enabled": false,
      "source": "local",
      "path": "../SDKs/agent/dart",
      "_comment": "Disabled as per requirements"
    }
  ]
}