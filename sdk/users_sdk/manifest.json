{
  "name": "users_sdk",
  "version": "1.0.0",
  "installs": [
    {
      "from": "templates/pages/customer",
      "to": "lib/customer/presentation/pages/profile"
    },
    {
      "from": "templates/pages/manager/add_address",
      "to": "lib/manager/presentation/pages/add_address.dart"
    },
    {
      "from": "templates/pages/manager/merchant",
      "to": "lib/manager/presentation/pages/merchant"
    },
    {
      "from": "templates/pages/driver/profile",
      "to": "lib/driver/presentation/pages/profile"
    },
    {
      "from": "templates/pages/customer/setting",
      "to": "lib/customer/presentation/pages/setting"
    }
  ],
  "routes": [
    {
      "path": "/setting",
      "page": "SettingRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/setting/setting_page.dart"
    },
    {
      "path": "/ProfilePage",
      "page": "ProfileRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/profile_page.dart"
    },
    {
      "path": "/wallet_history",
      "page": "WalletHistoryRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/wallet_history.dart"
    },
    {
      "path": "/create_shop",
      "page": "CreateShopRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/become_seller/create_shop.dart"
    },
    {
      "path": "/share_referral",
      "page": "ShareReferralRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/share_referral_page.dart"
    },
    {
      "path": "/share_referral_faq",
      "page": "ShareReferralFaqRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/share_referral_faq.dart"
    },
    {
      "path": "/notification_list_page",
      "page": "NotificationListRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/notification_page.dart"
    },
    {
      "path": "/address_list_page",
      "page": "AddressListRoute.page",
      "type": "MaterialRoute",
      "import": "package:rokctapp/customer/presentation/pages/profile/address_list.dart"
    },
    {
      "path": "/driver/profile",
      "page": "DriverProfileRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/driver/presentation/pages/profile/profile_page.dart"
    },
    {
      "path": "/driver/list-notification",
      "page": "DriverNotificationListRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/driver/presentation/pages/profile/notification_list_page.dart"
    },
    {
      "path": "/driver/delivery-zone",
      "page": "DriverDeliveryZoneRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/driver/presentation/pages/profile/delivery_zone/delivery_zone_page.dart"
    },
    {
      "path": "/manager/delivery-zone",
      "page": "ManagerDeliveryZoneRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/manager/presentation/pages/merchant/delivery_zone/delivery_zone_page.dart"
    },
    {
      "path": "/manager/list-notification",
      "page": "ManagerNotificationListRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/manager/presentation/pages/merchant/notification_list_page.dart"
    },
    {
      "path": "/manager/become_seller",
      "page": "ManagerCreateShopRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/manager/presentation/pages/become_seller/become_seller.dart"
    }
  ],
  "database": {
    "tables": [
      {
        "class": "UserTable",
        "import": "package:users_sdk/src/infrastructure/utils/drift_tables.dart"
      }
    ],
    "migration": {
      "version": 12,
      "step": "if (from < 8) { await m.createTable(userTable); }"
    }
  },
  "integrations": [
    {
      "target": "lib/manager/presentation/pages/become_seller/become_seller.dart",
      "placeholder": "// @become-seller-profile-imports",
      "replacement": "import 'package:users_sdk/src/application/manager/profile/profile_notifier.dart';\nimport 'package:users_sdk/src/application/manager/profile/profile_provider.dart';\nimport 'package:users_sdk/src/application/manager/profile/profile_state.dart';"
    },
    {
      "target": "lib/manager/presentation/pages/become_seller/become_seller.dart",
      "placeholder": "// @become-seller-profile-load",
      "replacement": "ref.read(profileProvider.notifier).resetShopData();\n      ref.read(profileProvider.notifier).fetchUser(context, onSuccess: (phone) { if (!AppConstants.isSpecificNumberEnabled) { phoneName.text = phone ?? ''; } else { final smt = PhoneNumber.fromCompleteNumber(completeNumber: \"+${phone?.replaceAll(\"+\", \"\")}\",); phoneName.text = smt.number; } },);"
    },
    {
      "target": "lib/manager/presentation/pages/become_seller/become_seller.dart",
      "placeholder": "// @become-seller-profile-event",
      "replacement": "event = ref.read(profileProvider.notifier);"
    }
  ]
}