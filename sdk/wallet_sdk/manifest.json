{
  "name": "wallet_sdk",
  "version": "1.0.0",
  "installs": [
    {
      "from": "templates/pages/income",
      "to": "lib/manager/presentation/pages/income"
    },
    {
      "from": "templates/pages/customer/wallet_history.dart",
      "to": "lib/customer/presentation/pages/profile/wallet_history.dart"
    },
    {
      "from": "templates/pages/customer/widgets/wallet_send_screen.dart",
      "to": "lib/customer/presentation/pages/profile/widgets/wallet_send_screen.dart"
    },
    {
      "from": "templates/pages/customer/widgets/wallet_topup_screen.dart",
      "to": "lib/customer/presentation/pages/profile/widgets/wallet_topup_screen.dart"
    }
  ],
  "routes": [
    {
      "path": "/manager/income",
      "page": "ManagerIncomeRoute.page",
      "type": "CupertinoRoute",
      "import": "package:rokctapp/manager/presentation/pages/income/income_page.dart"
    }
  ],
  "integrations": [
    {
      "target": "lib/customer/presentation/pages/profile/widgets/profile_items_list.dart",
      "placeholder": "// @profile-wallet-item",
      "replacement": "ProfileItem(colors: colors, title: \"${AppHelpers.getTranslation(TrKeys.wallet)}: ${AppHelpers.numberFormat(userData?.wallet?.price)}\", icon: FlutterRemix.wallet_3_line, onTap: () => context.pushRoute(const WalletHistoryRoute()),),"
    },
    {
      "target": "lib/customer/presentation/pages/main/main_page.dart",
      "placeholder": "// @main-page-imports",
      "replacement": "import 'package:rokctapp/customer/presentation/pages/profile/wallet_history.dart';"
    },
    {
      "target": "lib/customer/presentation/pages/main/main_page.dart",
      "placeholder": "// @main-tab-zero-2",
      "replacement": "LocalStorage.getToken().isNotEmpty ? IndexedStackChild(child: WalletHistoryPage(isBackButton: false)) : IndexedStackChild(child: LikePage(isBackButton: false)),"
    },
    {
      "target": "lib/customer/presentation/pages/main/main_page.dart",
      "placeholder": "// @main-tab-four-2",
      "replacement": "LocalStorage.getToken().isNotEmpty ? IndexedStackChild(child: WalletHistoryPage(isBackButton: false)) : IndexedStackChild(child: LikePage(isBackButton: false)),"
    }
  ]
}