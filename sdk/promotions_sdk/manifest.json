{
  "name": "promotions_sdk",
  "version": "1.0.0",
  "installs": [
    {
      "from": "templates/pages",
      "to": "lib/pages/promotions_sdk"
    },
    {
      "from": "templates/pages/driver/home/widgets/driver_stories.dart",
      "to": "lib/driver/presentation/pages/home/widgets/driver_stories.dart"
    }
  ],
  "routes": [],
  "database": {
    "tables": [
      {
        "class": "BannersTable",
        "import": "package:promotions_sdk/src/infrastructure/utils/drift_tables.dart"
      }
    ],
    "migration": {
      "version": 12,
      "step": "if (from < 7) { await m.createTable(bannersTable); }"
    }
  },
  "integrations": [
    {
      "target": "lib/customer/presentation/pages/profile/widgets/profile_items_list.dart",
      "placeholder": "// @profile-referral-item",
      "replacement": "if (AppHelpers.getReferralActive()) ProfileItem(colors: colors, title: TrKeys.inviteFriend, icon: FlutterRemix.money_dollar_circle_line, onTap: () => context.pushRoute(const ShareReferralRoute()),),"
    },
    {
      "target": "lib/driver/presentation/pages/home/bottom_sheet_screen.dart",
      "placeholder": "// @delivery-driver-stories-import",
      "replacement": "import 'package:rokctapp/driver/presentation/pages/home/widgets/driver_stories.dart';"
    },
    {
      "target": "lib/driver/presentation/pages/home/bottom_sheet_screen.dart",
      "placeholder": "// @delivery-driver-stories-list",
      "replacement": "SizedBox(height: 186.h, child: ListView.builder(padding: EdgeInsets.only(top: 24.h), scrollDirection: Axis.horizontal, itemCount: 3, itemBuilder: (context, index) { return DriverStoriesPage(image: image[index]); },),),"
    }
  ]
}